# Docker Compose Environment Variables
# Copy this file to .env.docker.local and customize for your local development

# Application Environment
NODE_ENV=development

# Database Configuration
POSTGRES_DB=kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=kairos123
POSTGRES_PORT=5432

# API Configuration
API_PORT=3333
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# Frontend Applications
WEB_ADMIN_PORT=4200
MEMBER_APP_PORT=4201
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_APP_NAME=Kairos Church Management
NEXT_PUBLIC_APP_VERSION=1.0.0

# Redis Configuration
REDIS_PORT=6379

# Database URL (constructed from above variables)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Development Tools
NEXT_TELEMETRY_DISABLED=1