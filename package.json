{
  "name": "kairos",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "build": "nx build",
    "build:all": "nx run-many --target=build --all --parallel=4",
    "build:all:prod": "nx run-many --target=build --configuration=production --all --parallel=4",
    "build:apps": "nx run-many --target=build --projects=web-admin,member-app,api --parallel=3",
    "build:apps:prod": "nx run-many --target=build --configuration=production --projects=web-admin,member-app,api --parallel=3",
    "build:libs": "nx run-many --target=build --projects=shared-types,shared-utils,ui --parallel=3",
    "build:web-admin": "nx build web-admin",
    "build:web-admin:prod": "nx build web-admin --configuration=production",
    "build:member-app": "nx build member-app",
    "build:member-app:prod": "nx build member-app --configuration=production",
    "build:api": "nx build api",
    "build:api:prod": "nx build api --configuration=production",
    "test": "nx test",
    "test:watch": "nx test --watch",
    "test:coverage": "nx run-many --target=test --coverage",
    "test:ci": "nx run-many --target=test --coverage --watchAll=false --passWithNoTests",
    "test:e2e": "node scripts/run-e2e-tests.js",
    "test:e2e:real": "node ./node_modules/jest/bin/jest.js tools/real-e2e-tests.spec.ts --verbose --detectOpenHandles --forceExit",
    "test:startup": "node ./node_modules/jest/bin/jest.js tools/application-startup-tests.spec.ts --verbose --detectOpenHandles --forceExit",
    "test:real-startup": "node ./node_modules/jest/bin/jest.js tools/real-application-startup.spec.ts --verbose --detectOpenHandles --forceExit --testTimeout=120000",
    "test:build-verification": "node ./node_modules/jest/bin/jest.js tools/build-verification.spec.ts --verbose --testTimeout=180000",
    "test:scaffold": "node ./node_modules/jest/bin/jest.js tools/scaffold-validation.spec.ts --passWithNoTests",
    "test:smoke": "node ./node_modules/jest/bin/jest.js tools/e2e-smoke-tests.spec.ts --passWithNoTests",
    "lint": "nx workspace-lint && nx lint",
    "lint:fix": "nx affected:lint --fix",
    "e2e": "nx e2e",
    "e2e:ci": "nx run-many --target=e2e --parallel=1",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:build:prod": "nx affected:build --configuration=production",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:test:coverage": "nx affected:test --coverage",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "clean": "nx reset && rm -rf dist node_modules/.cache",
    "clean:cache": "nx reset",
    "clean:dist": "rm -rf dist",
    "clean:node_modules": "rm -rf node_modules",
    "prebuild": "npm run clean:dist",
    "prebuild:all": "npm run clean:dist",
    "build:optimize": "node scripts/build-optimization.js",
    "build:optimize:prod": "node scripts/build-optimization.js --production",
    "build:affected:optimize": "node scripts/build-optimization.js affected",
    "build:affected:optimize:prod": "node scripts/build-optimization.js affected --production",
    "build:libs:optimize": "node scripts/build-optimization.js libs",
    "build:apps:optimize": "node scripts/build-optimization.js apps",
    "cache:warm": "node scripts/build-optimization.js cache",
    "validate:build-config": "node scripts/validate-build-config.js",
    "format": "prettier --write .",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "prepare": "husky install",
    "postinstall": "node ./decorate-angular-cli.js",
    "docker:setup": "cp .env.docker .env.docker.local",
    "docker:build": "docker-compose --env-file .env.docker.local build",
    "docker:start": "docker-compose --env-file .env.docker.local up -d",
    "docker:stop": "docker-compose --env-file .env.docker.local down",
    "docker:logs": "docker-compose --env-file .env.docker.local logs -f",
    "docker:status": "docker-compose --env-file .env.docker.local ps",
    "docker:migrate": "docker-compose --env-file .env.docker.local exec api npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "docker:seed": "docker-compose --env-file .env.docker.local exec api npx prisma db seed --schema=apps/api/prisma/schema.prisma",
    "docker:clean": "docker system prune -f",
    "task:list": "node scripts/task-runner.js list",
    "task:start": "node scripts/task-runner.js start",
    "task:progress": "node scripts/task-runner.js progress",
    "task:summary": "node scripts/task-runner.js summary",
    "task:dashboard": "node scripts/open-dashboard.js"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "clsx": "^2.1.0",
    "next": "14.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^2.2.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@nx/eslint": "18.0.4",
    "@nx/eslint-plugin": "18.0.4",
    "@nx/jest": "18.0.4",
    "@nx/js": "18.0.4",
    "@nx/nest": "18.0.4",
    "@nx/next": "18.0.4",
    "@nx/node": "18.0.4",
    "@nx/playwright": "18.0.4",
    "@nx/react": "18.0.4",
    "@nx/vite": "18.0.4",
    "@nx/workspace": "18.0.4",
    "@playwright/test": "^1.41.0",
    "@swc-node/register": "~1.6.8",
    "@swc/core": "~1.3.105",
    "@swc/helpers": "~0.5.3",
    "@swc/jest": "^0.2.29",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "14.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "~8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-playwright": "^0.20.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nx": "18.0.4",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "prisma": "^5.8.0",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "ts-node": "10.9.2",
    "typescript": "~5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.2"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
