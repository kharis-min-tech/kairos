{
  "name": "kairos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"bgMagenta.bold,bgCyan.bold\" --prefix \"[{name}]\" --names \"api,web\" \"cd apps/api && npm run dev\" \"cd apps/web && npx next dev --port 3000\"",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate --filter=@kairos/database",
    "db:migrate": "turbo db:migrate --filter=@kairos/database",
    "db:studio": "turbo db:studio --filter=@kairos/database",
    "db:seed": "turbo db:seed --filter=@kairos/database"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
