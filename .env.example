DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos
PORT=3001

# Secrets. These three have no usable default outside local development — the
# API fails closed without them rather than falling back to a value committed
# to this repository. In deployed environments they are Worker secrets, set
# with `wrangler secret put <NAME>` (add `--env staging` for staging), never
# vars in wrangler.jsonc.
JWT_SECRET=local-dev-secret-change-in-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production
SELF_CHECK_IN_QR_SECRET=local-dev-qr-secret-change-in-production

# Mapbox (for fellowship map)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
