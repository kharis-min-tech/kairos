DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos
JWT_SECRET=local-dev-secret-change-in-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production
PORT=3001

# Mapbox (for fellowship map)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Deepgram — narration and caption timings for the tour videos.
# Build-time only: used by tools/tour-video, never shipped to a browser.
# Put the real key in tools/tour-video/.env (gitignored), not here.
DEEPGRAM_API_KEY=your-deepgram-api-key
