# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kairos_db?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3333
NODE_ENV="development"

# CORS Configuration
CORS_ORIGIN="http://localhost:4200,http://localhost:4201"

# Logging
LOG_LEVEL="debug"