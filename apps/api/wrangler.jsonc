{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kairos-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],

  // Path-based routing under the Pages custom domain. The Worker handles
  // `/api/*` on kairos.kharis.org; Pages serves everything else. Same-origin
  // means zero CORS preflight overhead from the web app.
  "routes": [
    { "pattern": "kairos.kharis.org/api/*", "zone_name": "kharis.org" }
  ],

  // Hyperdrive binding — fronts PlanetScale Postgres (kairos-prod).
  // Paste the Hyperdrive config ID from the Cloudflare dashboard:
  //   Workers & Pages → Hyperdrive → kairos-prod-hyperdrive → copy ID.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b58cd59e2ccc4263804f9d0521435748"
    }
  ],

  // Non-secret vars. Secrets (JWT_SECRET, AWS keys, CF_IMAGES_TOKEN, etc.)
  // are set via `wrangler secret put` and DO NOT belong in this file.
  //
  // Cloudflare Images secrets to set per env (once):
  //   wrangler secret put CF_IMAGES_ACCOUNT_ID       # numeric CF account id
  //   wrangler secret put CF_IMAGES_ACCOUNT_HASH     # short public hash
  //   wrangler secret put CF_IMAGES_TOKEN            # API token with Images:Edit
  //   (…and `--env staging` variants for staging)
  //
  // Rotating QR (member self-check-in) secret — signs the stateless HMAC that
  // encodes {serviceId, timeBucket}. See docs/self-check-in.md.
  //   wrangler secret put SELF_CHECK_IN_QR_SECRET              # prod
  //   wrangler secret put --env staging SELF_CHECK_IN_QR_SECRET # staging
  // Generate with: openssl rand -base64 48
  "vars": {
    "AWS_REGION": "eu-west-2",
    "SES_CONFIGURATION_SET": "kairos-transactional"
  },

  // Enable head sampling for logs in the Cloudflare dashboard.
  "observability": {
    "enabled": true
  },

  // Daily crons. The handler in worker.ts switches on cron expression.
  //   - "0 3 * * *" → lifecycle (#4 Phase C/D): aging-out + visitor promotion
  //   - "0 8 * * *" → notification digest (Phase 6): rolls up pending
  //                    workflow / lifecycle / forms events into one email per
  //                    (member, category).
  // Single-region scope for v1 — see [[project-design-decisions-2026-06-29]];
  // per-branch local-TZ digest is deferred to multi-region work.
  "triggers": {
    "crons": ["0 3 * * *", "0 8 * * *"]
  },

  // ────────────────────────────────────────────────────────────────
  // Named environments. `wrangler deploy` (no --env) hits the top-level
  // production config above. `wrangler deploy --env staging` deploys the
  // staging Worker below.
  //
  // Wrangler env blocks do NOT inherit vars/routes/bindings/triggers from
  // top-level — every knob has to be restated here to be active in staging.
  //
  // Staging shares the code but is fully isolated at every runtime edge:
  //   - Different Worker name (routing table won't collide)
  //   - Different Hyperdrive → different PlanetScale branch (schema-only fork)
  //   - Different SES configuration set (bounce/complaint metrics + suppression
  //     list stay separate from prod)
  //   - Different JWT secrets (staging tokens can't unlock prod)
  //   - Different FRONTEND_URL (email links land on staging.kairos.kharis.org)
  //
  // One-time setup checklist for staging:
  //   1. pscale branch create kairos staging --schema-only
  //   2. Cloudflare → Hyperdrive → create pointing at staging PS branch → copy ID
  //   3. Replace REPLACE_ME_STAGING_HYPERDRIVE_ID below
  //   4. wrangler secret put --env staging JWT_SECRET
  //      (and: JWT_REFRESH_SECRET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
  //       EMAIL_FROM, FRONTEND_URL)
  //   5. Cloudflare → DNS → route staging.kairos.kharis.org into the zone
  //      (Pages custom domain covers the /* half; this Worker's route covers
  //       /api/*)
  //   6. AWS SES → Configuration sets → create `kairos-staging`
  //   7. wrangler deploy --env staging   (from apps/api)
  // ────────────────────────────────────────────────────────────────
  "env": {
    "staging": {
      "name": "kairos-api-staging",
      "routes": [
        { "pattern": "staging.kairos.kharis.org/api/*", "zone_name": "kharis.org" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "775cdc5aea814585baa05de36696f12c"
        }
      ],
      "vars": {
        "AWS_REGION": "eu-west-2",
        "SES_CONFIGURATION_SET": "kairos-staging"
      },
      "observability": {
        "enabled": true
      },
      "triggers": {
        "crons": ["0 3 * * *", "0 8 * * *"]
      }
    }
  }
}