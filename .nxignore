# NX Ignore File
# Files and directories to exclude from NX workspace analysis

# Build artifacts
dist/
build/
out/

# Dependencies
node_modules/
.pnp/
.pnp.js

# Cache directories
.nx/cache/
.next/
.nuxt/
.cache/
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage reports
coverage/
*.lcov
.nyc_output/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Docker
.dockerignore
Dockerfile*
docker-compose*.yml

# Documentation (for build optimization)
*.md
docs/
documentation/

# Test files (for production builds)
**/*.spec.ts
**/*.spec.tsx
**/*.test.ts
**/*.test.tsx
**/__tests__/
**/test/
**/tests/

# Storybook
.storybook/
**/*.stories.*

# Backup files
*.bak
*.backup