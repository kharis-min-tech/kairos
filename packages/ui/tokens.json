{
  "$schema": "https://schemas.kharis.org/design-tokens/v1.json",
  "name": "modern-sanctuary",
  "version": "1.0.0",
  "description": "Kairos design tokens — Modern Sanctuary. Portable JSON snapshot. The Tailwind bridge lives in apps/web/tailwind.config.ts and the runtime CSS vars in apps/web/src/app/globals.css.",
  "color": {
    "primary": {
      "50":  "#f3f1fd",
      "100": "#e7e3fb",
      "200": "#cfc6f7",
      "300": "#aea0f0",
      "400": "#8970e6",
      "500": "#6f51da",
      "600": "#5d3fd3",
      "700": "#4d33b6",
      "800": "#3f2b96",
      "900": "#342677",
      "950": "#1f1750",
      "gradient": {
        "from": "#451ebb",
        "to":   "#5d3fd3",
        "angle": "135deg"
      }
    },
    "accent": {
      "50":  "#fefbed",
      "100": "#fdf3c7",
      "200": "#fce18a",
      "300": "#facb52",
      "400": "#f8b537",
      "500": "#ed9d18",
      "600": "#d18012",
      "700": "#ad6313",
      "800": "#8c4f15",
      "900": "#744116",
      "950": "#432308"
    },
    "success": {
      "50":  "#ecfdf5",
      "100": "#d1fae5",
      "200": "#a7f3d0",
      "300": "#6ee7b7",
      "400": "#34d399",
      "500": "#10b981",
      "600": "#059669",
      "700": "#047857",
      "800": "#065f46",
      "900": "#064e3b"
    },
    "error": {
      "50":  "#fff1f2",
      "100": "#ffe4e6",
      "200": "#fecdd3",
      "300": "#fda4af",
      "400": "#fb7185",
      "500": "#f43f5e",
      "600": "#e11d48",
      "700": "#be123c",
      "800": "#9f1239",
      "900": "#881337"
    },
    "surface": {
      "light": {
        "background": "#fafafa",
        "card":       "#ffffff",
        "muted":      "#f3f3f3",
        "secondary":  "#f5f5f5",
        "border":     "#ebebeb",
        "input":      "#cec8d7"
      },
      "dark": {
        "background": "#0a0a0a",
        "card":       "#141414",
        "muted":      "#1c1c1c",
        "secondary":  "#212121",
        "border":     "#242424",
        "input":      "#3d3949"
      }
    },
    "text": {
      "light": {
        "on-surface":       "#1c1c1c",
        "on-surface-muted": "#737373",
        "on-primary":       "#ffffff"
      },
      "dark": {
        "on-surface":       "#f0f0f0",
        "on-surface-muted": "#949494",
        "on-primary":       "#ffffff"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["var(--font-inter)", "system-ui", "sans-serif"],
      "mono": ["var(--font-mono)", "ui-monospace", "monospace"]
    },
    "scale": {
      "xs":  { "size": "0.75rem",  "lineHeight": "1rem" },
      "sm":  { "size": "0.875rem", "lineHeight": "1.25rem" },
      "base":{ "size": "1rem",     "lineHeight": "1.5rem" },
      "lg":  { "size": "1.125rem", "lineHeight": "1.75rem" },
      "xl":  { "size": "1.25rem",  "lineHeight": "1.75rem" },
      "2xl": { "size": "1.5rem",   "lineHeight": "2rem" },
      "3xl": { "size": "1.875rem", "lineHeight": "2.25rem" }
    },
    "weight": {
      "normal":   400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    }
  },
  "radius": {
    "base": "0.25rem",
    "sm":   "calc(0.25rem - 4px)",
    "md":   "calc(0.25rem - 2px)",
    "lg":   "0.25rem",
    "full": "9999px"
  },
  "shadow": {
    "ambient":    "0 8px 24px rgba(26, 28, 28, 0.06)",
    "ambient-lg": "0 8px 40px rgba(26, 28, 28, 0.06)"
  },
  "spacing": {
    "note": "Uses Tailwind default 4px scale (space-1 = 0.25rem, space-2 = 0.5rem, …). No custom values."
  },
  "focus": {
    "ring": {
      "color":  "#f8b537",
      "width":  "2px",
      "offset": "2px"
    }
  }
}
