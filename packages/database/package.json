{
  "name": "@kairos/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:drop": "tsx src/reset.ts",
    "db:fresh": "npm run db:drop && drizzle-kit migrate && tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed-souls": "tsx src/seed-souls.ts",
    "db:seed-admin": "tsx src/seed-admin.ts"
  },
  "dependencies": {
    "@kairos/utils": "*",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
