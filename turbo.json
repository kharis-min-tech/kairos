{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:drop": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:fresh": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed-souls": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed-admin": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD",
        "ADMIN_FIRST_NAME",
        "ADMIN_LAST_NAME",
        "ADMIN_REGION_NAME",
        "ADMIN_REGION_COUNTRY",
        "ADMIN_BRANCH_NAME",
        "ADMIN_RESET_PASSWORD"
      ]
    }
  }
}
