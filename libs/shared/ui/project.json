{
  "name": "ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/ui",
        "main": "libs/shared/ui/src/index.ts",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json",
        "assets": ["libs/shared/ui/*.md", "libs/shared/ui/src/styles.css"]
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/ui/tsconfig.lib.json"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/shared/ui/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/ui/jest.config.ts"
      }
    }
  },
  "tags": ["type:ui", "scope:shared"]
}
