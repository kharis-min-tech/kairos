# Cognito Configuration
# Get these values after deploying CDK infrastructure

# User Pool ID (e.g., eu-north-1_XXXXXXXXX)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-north-1_OM97wjySK

# Client ID (e.g., xxxxxxxxxxxxxxxxxxxxxxxxxx)
NEXT_PUBLIC_COGNITO_CLIENT_ID=7mqmc57sb18ideegj293pk81ib

# AWS Region
NEXT_PUBLIC_COGNITO_REGION=eu-north-1

# Cognito Domain (e.g., https://your-domain.auth.region.amazoncognito.com)
NEXT_PUBLIC_COGNITO_DOMAIN=https://eu-north-1om97wjysk.auth.eu-north-1.amazoncognito.com

# Authority URL (OIDC issuer)
NEXT_PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_OM97wjySK

# Optional: Base URL for your application (auto-detected if not set)
# NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Note: The application will automatically detect the current URL
# This allows it to work on any laptop/device without hardcoding localhost
